# Copy to .env and set your own values. .env is git-ignored. Passwords: no single quote (').
# SQL Server requires strong passwords: 8+ characters with upper and lower case, digits and symbols.
MSSQL_SA_PASSWORD=
CRM_DB_NAME=crm
CRM_DB_MIGRATOR_USER=crm_migrator
CRM_DB_MIGRATOR_PASSWORD=
CRM_DB_APP_USER=crm_app
CRM_DB_APP_PASSWORD=

# First administrator, created on start when the database has no ADMIN.
CRM_ADMIN_LOGIN=admin
CRM_ADMIN_PASSWORD=

# Host ports (bound to 127.0.0.1).
CRM_HTTP_PORT=8088
CRM_DB_HOST_PORT=14333

# Application
CRM_DB_POOL_SIZE=30
CRM_LOGIN_MAX_FAILED=5
CRM_LOGIN_LOCK_MINUTES=15
# One-click login as any seeded user on the login page (local only; never on a shared server).
CRM_DEV_LOGIN=true

# Seed (./start.sh --seed). Password of all perf.* users (perf.admin.0001, perf.manager.0001, perf.sales.0001, ...).
CRM_SEED_PASSWORD=
CRM_SEED_CLIENTS=5000000
CRM_SEED_ADMINS=10
CRM_SEED_MANAGERS=490
CRM_SEED_SALES=4500
CRM_SEED_TEAM_SIZE=5
CRM_SEED_PROJECTS=5000000
CRM_SEED_COMMENTS=2000000
CRM_SEED_RANDOM_SEED=42
CRM_SEED_BATCH_SIZE=500000
