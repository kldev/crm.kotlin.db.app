# Backup of the GitHub Actions CI (removed from .github/workflows on purpose: verification is local, docker compose up).
# To restore: git mv .github/ci.yml.bak .github/workflows/ci.yml
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "25"
      - uses: gradle/actions/setup-gradle@v4
      # build = compile + tests + verifyNoOrm (ADR-0002).
      - run: ./gradlew build --no-daemon
      - name: Docker image builds
        run: docker build -t crm-app:ci .

  frontend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - run: corepack enable
      - run: yarn install --immutable
      # Biome (lint + format), route tree, tsc and the Vite build.
      - run: yarn check
      - run: yarn build
